  "targets": [
    {
      "name": "Local Translator",
      "id": "F28A09EC30761B51002464BD",
      "product": "Products/Local Translator.app",
      "product-type": "application",
      "dependencies": [
        "Local Translator Extension",
      ],
      "build-phases": [
        "compile-sources",
