        "INFOPLIST_FILE": "Local Translator/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Local Translator",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "INFOPLIST_KEY_NSPrincipalClass": "NSApplication",
        "INFOPLIST_KEY_NSViewGestureRecognizerIsExclusive": "NO",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "OTHER_LDFLAGS": [
          "-framework",
          "SafariServices",
          "-framework",
          "WebKit",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.tmtmtmtmtmt.localtranslator",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "Local Translator Extension",
      "id": "F28A0A0730761B53002464BD",
      "product": "Products/Local Translator Extension.appex",
