   },
   "error": null
  },
  {
   "id": "zh-Hant-link-01",
   "ms": 511,
   "slots": {
    "0": "按下",
    "1": "即可繼續。"
   },
   "error": null,
   "xPreserved": true
  },
  {
   "id": "zh-Hant-link-02",
   "ms": 433,
   "slots": {
    "0": "如需瞭解支援的平台,請參閱",
    "1": "。"
   },
   "error": null,
   "xPreserved": true
  },
  {
   "id": "zh-Hant-link-03",
   "ms": 457,
   "slots": {
