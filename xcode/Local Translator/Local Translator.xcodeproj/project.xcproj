        { "path": "<PRODUCTS>/Local Translator Extension.appex", "id": "F28A0A0830761B53002464BD", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Local Translator/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
